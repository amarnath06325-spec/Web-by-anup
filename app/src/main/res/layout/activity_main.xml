<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Top Address / Search Bar with Google Profile Picture & 3-Dot Menu (Chrome UI Style) -->
    <LinearLayout
        android:id="@+id/top_address_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Address Pill -->
            <LinearLayout
                android:id="@+id/address_bar_pill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/address_bar_bg"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Security / Search Icon -->
                <ImageView
                    android:id="@+id/iv_security_badge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Security info"
                    android:src="@android:drawable/ic_menu_search" />

                <!-- Search / URL Input Box -->
                <EditText
                    android:id="@+id/et_search_url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@null"
                    android:hint="Search or type URL"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <!-- Refresh / Stop Button -->
                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh Page"
                    android:src="@android:drawable/ic_menu_rotate" />
            </LinearLayout>

            <!-- Google Profile Picture Icon (Chrome UI Style) -->
            <FrameLayout
                android:id="@+id/btn_profile_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_profile_picture"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="Google Profile"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </FrameLayout>

            <!-- 3-Dot Overflow Menu Button (Leading to SettingsActivity) -->
            <ImageButton
                android:id="@+id/btn_top_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings and Options"
                android:src="@android:drawable/ic_menu_more" />

        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/page_loading_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Main Content Frame: Houses WebView or Start Page -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Primary WebView -->
        <WebView
            android:id="@+id/main_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

    </FrameLayout>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreen_custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Bottom Navigation Bar ("Home / Back wale tab sabse niche") -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- 1. Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Back"
            android:src="@android:drawable/ic_media_previous" />

        <!-- 2. Forward Button -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Forward"
            android:src="@android:drawable/ic_media_next" />

        <!-- 3. Home Button -->
        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@android:drawable/ic_menu_myplaces" />

        <!-- 4. Bookmark Button -->
        <ImageButton
            android:id="@+id/btn_bookmark"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmarks"
            android:src="@android:drawable/btn_star" />

        <!-- 5. Tabs Switcher Button -->
        <FrameLayout
            android:id="@+id/btn_tab_switcher"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tv_tab_count"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/address_bar_bg"
                android:textColor="?android:attr/textColorPrimary" />
        </FrameLayout>

        <!-- 6. Menu Button -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_more" />

    </LinearLayout>

</LinearLayout>
